<mxfile host="app.diagrams.net" modified="2026-04-21" type="device">
  <diagram name="Noisy-OR ICI" id="noisy-or-ici">
    <mxGraphModel dx="1800" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title + subtitle -->
        <mxCell id="title" value="Independent causal influence (Noisy-OR)" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0033A0;fontSize=34;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="1400" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Each candidate factor xᵢ triggers the outcome independently with probability cᵢ. The observed outcome is the OR of the hidden triggers." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=18;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="90" width="1400" height="26" as="geometry"/>
        </mxCell>

        <!-- Factor 1 -->
        <mxCell id="x1" value="x₁&#xa;mech. vent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#0033A0;strokeColor=#005DAA;strokeWidth=3;fontSize=18;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="c₁" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6EEF9;fontColor=#0033A0;strokeColor=#005DAA;strokeWidth=2;fontSize=18;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="195" width="60" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="H₁" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#8A94A6;strokeColor=#8A94A6;strokeWidth=2;strokeDasharray=4 3;fontSize=18;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="195" width="60" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_x1_c1" style="endArrow=none;strokeColor=#005DAA;strokeWidth=3;" edge="1" source="x1" target="c1" parent="1"/>
        <mxCell id="e_c1_h1" style="endArrow=classic;strokeColor=#005DAA;strokeWidth=3;endSize=4;" edge="1" source="c1" target="h1" parent="1"/>

        <!-- Factor 2 (orange — featured) -->
        <mxCell id="x2" value="x₂&#xa;hypoalbuminemia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D64309;fontColor=#ffffff;strokeColor=#D64309;strokeWidth=3;fontSize=18;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="120" y="300" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="c₂" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FBE5D8;fontColor=#D64309;strokeColor=#D64309;strokeWidth=2;fontSize=18;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="315" width="60" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="H₂" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#8A94A6;strokeColor=#8A94A6;strokeWidth=2;strokeDasharray=4 3;fontSize=18;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="315" width="60" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_x2_c2" style="endArrow=none;strokeColor=#D64309;strokeWidth=3;" edge="1" source="x2" target="c2" parent="1"/>
        <mxCell id="e_c2_h2" style="endArrow=classic;strokeColor=#D64309;strokeWidth=3;endSize=4;" edge="1" source="c2" target="h2" parent="1"/>

        <!-- Factor 3 -->
        <mxCell id="x3" value="x₃&#xa;immobility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#0033A0;strokeColor=#005DAA;strokeWidth=3;fontSize=18;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="120" y="420" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="c₃" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6EEF9;fontColor=#0033A0;strokeColor=#005DAA;strokeWidth=2;fontSize=18;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="435" width="60" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="H₃" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#8A94A6;strokeColor=#8A94A6;strokeWidth=2;strokeDasharray=4 3;fontSize=18;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="435" width="60" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e_x3_c3" style="endArrow=none;strokeColor=#005DAA;strokeWidth=3;" edge="1" source="x3" target="c3" parent="1"/>
        <mxCell id="e_c3_h3" style="endArrow=classic;strokeColor=#005DAA;strokeWidth=3;endSize=4;" edge="1" source="c3" target="h3" parent="1"/>

        <!-- OR gate -->
        <mxCell id="orGate" value="OR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0033A0;fontColor=#ffffff;strokeColor=#0033A0;strokeWidth=3;fontSize=26;fontFamily=Arial;fontStyle=1;arcSize=40;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="100" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_h1_or" style="endArrow=classic;strokeColor=#8A94A6;strokeWidth=3;endSize=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="215" as="sourcePoint"/>
            <mxPoint x="680" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_h2_or" style="endArrow=classic;strokeColor=#8A94A6;strokeWidth=3;endSize=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="335" as="sourcePoint"/>
            <mxPoint x="680" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_h3_or" style="endArrow=classic;strokeColor=#8A94A6;strokeWidth=3;endSize=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="455" as="sourcePoint"/>
            <mxPoint x="680" y="380" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Outcome Y -->
        <mxCell id="y" value="Y&#xa;HAPrI" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#0033A0;strokeColor=#0033A0;strokeWidth=5;fontSize=22;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="290" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e_or_y" style="endArrow=classic;strokeColor=#0033A0;strokeWidth=5;endSize=5;" edge="1" source="orGate" target="y" parent="1"/>

        <!-- Equation 1 (exact) -->
        <mxCell id="eq1title" value="Probability of Y" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#8A94A6;fontSize=13;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="180" width="480" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="eq1" value="P(Y = 1 | x) = 1 − ∏ᵢ (1 − cᵢ xᵢ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FC;fontColor=#0033A0;strokeColor=#005DAA;strokeWidth=3;fontSize=26;fontFamily=Courier New;fontStyle=1;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="205" width="560" height="70" as="geometry"/>
        </mxCell>

        <!-- Equation 2 (approximation) -->
        <mxCell id="eq2title" value="Small-cᵢ approximation" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#8A94A6;fontSize=13;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="300" width="480" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="eq2" value="P(Y = 1 | x)  ≈  Σᵢ cᵢ xᵢ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5D8;fontColor=#D64309;strokeColor=#D64309;strokeWidth=3;fontSize=26;fontFamily=Courier New;fontStyle=1;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="325" width="560" height="70" as="geometry"/>
        </mxCell>

        <!-- Interpretation -->
        <mxCell id="interp" value="When every cᵢ is small, contributions add.&#xa;Each cᵢ reads as an interpretable per-factor causal contribution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#3F4444;strokeColor=#CDCDCD;strokeWidth=2;fontSize=17;fontFamily=Arial;fontStyle=0;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="420" width="560" height="70" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="xᵢ  observed factor        cᵢ  per-factor activation probability        Hᵢ  hidden trigger (latent)" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=15;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="580" width="1400" height="28" as="geometry"/>
        </mxCell>

        <!-- Hidden-triggers caveat -->
        <mxCell id="caveat" value="Assumption: the hidden triggers Hᵢ are conditionally independent given xᵢ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FC;fontColor=#8A94A6;strokeColor=#CDCDCD;strokeWidth=1;fontSize=14;fontFamily=Arial;fontStyle=2;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="625" width="1000" height="36" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
