        <mxCell id="resolvesBox" value="&lt;b style=&quot;color:#D64309&quot;&gt;What temporal precedence resolves:&lt;/b&gt;&lt;br/&gt;Drug B dispense is &lt;b&gt;after&lt;/b&gt; the ADR. The collider/additive stories are ruled out; the ADR-on-A hypothesis becomes the only CPDAG-compatible orientation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;fontColor=#3F4444;strokeColor=#D64309;strokeWidth=2;fontSize=13;fontFamily=Arial;arcSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="620" width="680" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="legendBox" value="&lt;b&gt;WHAT THE OBJECT MODEL CARRIES THAT THE FLAT TABLE DOES NOT&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Dispense runs&lt;/b&gt; — start/stop dates of drug A and drug B, not a single &#39;ever-exposed&#39; flag.&lt;br/&gt;• &lt;b&gt;ADR onset date&lt;/b&gt; — the timestamp rules out drug B (not yet started) and pins blame on A.&lt;br/&gt;• &lt;b&gt;Switch event&lt;/b&gt; — transition from A to B as a distinct relational sub-object on the patient." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FC;fontColor=#3F4444;strokeColor=#CDCDCD;strokeWidth=1;fontSize=12;fontFamily=Arial;arcSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
