        <mxCell id="resolvesBox" value="&lt;b style=&quot;color:#D64309&quot;&gt;What temporal precedence resolves:&lt;/b&gt;&lt;br/&gt;Across millions of patients, the distribution of diagnosis order pins down a single progression graph. Payers can locate the intervention window — here, glycemic control." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;fontColor=#3F4444;strokeColor=#D64309;strokeWidth=2;fontSize=13;fontFamily=Arial;arcSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="620" width="680" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="legendBox" value="&lt;b&gt;WHAT THE OBJECT MODEL CARRIES THAT THE FLAT TABLE DOES NOT&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;First-diagnosis dates&lt;/b&gt; — when each condition was &lt;i&gt;first&lt;/i&gt; recorded, not merely whether it is ever present.&lt;br/&gt;• &lt;b&gt;Terminal/progression node&lt;/b&gt; — CKD anchored as sequela, not as a co-occurring flag.&lt;br/&gt;• &lt;b&gt;Cross-patient aggregation&lt;/b&gt; — progression graph averaged over dated trajectories." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FC;fontColor=#3F4444;strokeColor=#CDCDCD;strokeWidth=1;fontSize=12;fontFamily=Arial;arcSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
