        </mxCell>
        <mxCell id="b4cite" value="&lt;i&gt;Target-trial emulation:&lt;br/&gt;Hern&#225;n &amp; Robins (2016)&lt;br/&gt;TMLE: vdL &amp; Rubin (2006)&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#8A94A6;fontSize=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="801" y="420" width="203" height="100" as="geometry"/>
