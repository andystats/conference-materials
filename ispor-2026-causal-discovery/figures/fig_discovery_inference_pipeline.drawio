<mxfile host="app.diagrams.net" modified="2026-04-21" type="device">
  <diagram name="Discovery to Inference Pipeline" id="discovery-inference-pipeline">
    <mxGraphModel dx="1050" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="660">
      <root>
        <mxCell id="0"/>
