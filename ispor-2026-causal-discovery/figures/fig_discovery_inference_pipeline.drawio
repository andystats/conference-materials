        <mxCell id="b4title" value="Target trial / TMLE" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#D64309;fontSize=16;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="851" y="112" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b4body" value="Emulate the would-be RCT,&#xa;then estimate the candidate&#xa;effect with TMLE or longi-&#xa;tudinal g-methods. Doubly&#xa;robust: consistent if either&#xa;model is correct." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=16;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="801" y="164" width="200" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="b4eq" value="&#968; =&#xa;E[Y^(a=1) &#8722; Y^(a=0)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#D64309;strokeColor=#D64309;strokeWidth=2;fontSize=16;fontFamily=Courier New;fontStyle=1;arcSize=6;align=center;" vertex="1" parent="1">
