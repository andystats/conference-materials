        <mxCell id="title" value="From discovery to inference" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0033A0;fontSize=22;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="16" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Discovery prioritizes; clinicians arbitrate; confirmatory estimation settles the effect." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=16;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="75" y="52" width="900" height="24" as="geometry"/>
        </mxCell>

        <!-- ==== BLOCK 1 — Object representation ==== -->
        <mxCell id="b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#0033A0;strokeWidth=2.5;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="235" height="490" as="geometry"/>
        </mxCell>
        <mxCell id="b1num" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0033A0;fontColor=#ffffff;strokeColor=#0033A0;fontSize=20;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="36" y="112" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b1title" value="Object rep." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0033A0;fontSize=16;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="86" y="112" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b1body" value="Encode every patient as&#xa;a temporally ordered&#xa;object with dated labs,&#xa;meds, procedures, and&#xa;transfers." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=16;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="36" y="164" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="b1inset" value="Patient&#xa;&#9500; Admission (t=0)&#xa;&#9500; Labs (albumin)&#xa;&#9500; Meds (pressors)&#xa;&#9500; Procedures&#xa;&#9500; Microbiology&#xa;&#9492; Transfers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#0033A0;strokeColor=#005DAA;strokeWidth=1.5;fontSize=16;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="36" y="296" width="203" height="276" as="geometry"/>
