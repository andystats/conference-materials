          <mxGeometry x="341" y="112" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b2body" value="Search millions of object-&#xa;tree projections. Temporal&#xa;precedence (&#964; &lt; 0) and&#xa;relational structure orient&#xa;edges a flat CPDAG leaves&#xa;ambiguous." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=16;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
