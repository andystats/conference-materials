          <mxGeometry x="546" y="112" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b3title" value="Clinician review" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#783C96;fontSize=16;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="596" y="112" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b3body" value="Domain experts prune&#xa;implausible edges and&#xa;endorse the subset worth&#xa;confirmatory work; those&#xa;become pre-specified&#xa;estimands." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=16;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="546" y="164" width="200" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="b3list" value="&lt;font color=&quot;#5B8A5E&quot;&gt;&#10003; Hypoalbuminemia&lt;/font&gt;&#xa;&lt;font color=&quot;#5B8A5E&quot;&gt;&#10003; Immobility&lt;/font&gt;&#xa;&lt;font color=&quot;#5B8A5E&quot;&gt;&#10003; Mech. ventilation&lt;/font&gt;&#xa;&lt;font color=&quot;#5B8A5E&quot;&gt;&#10003; Yeast colonization&lt;/font&gt;&#xa;&#xa;&lt;font color=&quot;#D64309&quot;&gt;&#10007; Spurious lab edge&lt;/font&gt;&#xa;&#xa;&lt;font color=&quot;#783C96&quot;&gt;? Fluid timing&lt;/font&gt;&#xa;&lt;font color=&quot;#783C96&quot;&gt;? Albumin dosing&lt;/font&gt;&#xa;&#xa;&lt;i&gt;&lt;font color=&quot;#8A94A6&quot;&gt;kept &#183; pruned &#183; flagged&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#783C96;strokeWidth=1.5;fontSize=16;fontFamily=Courier New;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1">
