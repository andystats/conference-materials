        <mxCell id="b2num" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0033A0;fontColor=#ffffff;strokeColor=#0033A0;fontSize=20;fontFamily=Arial;fontStyle=1;align=center;" vertex="1" parent="1">
