        <!-- Footer legend -->
        <mxCell id="legendBox" value="&lt;b&gt;WHAT THE OBJECT MODEL CARRIES THAT THE FLAT TABLE DOES NOT&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Event timestamps&lt;/b&gt; — sepsis dx at t=1h vs. antibiotic at t=3h fixes the chain direction.&lt;br/&gt;• &lt;b&gt;Candidate intervention node&lt;/b&gt; — antibiotic as a timed action, not a static indicator.&lt;br/&gt;• &lt;b&gt;Outcome with follow-up window&lt;/b&gt; — mortality anchored to an admission object, not a column." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FC;fontColor=#3F4444;strokeColor=#CDCDCD;strokeWidth=1;fontSize=12;fontFamily=Arial;arcSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
