<mxfile host="app.diagrams.net" modified="2026-04-21" type="device">
  <diagram name="Albumin relative time" id="albumin-relative-time">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title + subtitle -->
        <mxCell id="title" value="Albumin aligned to HAPrI diagnosis" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0033A0;fontSize=38;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="1400" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Serum albumin drops below normal days before index and remains depressed afterwards. Illustrative trajectory." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#3F4444;fontSize=22;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="1400" height="30" as="geometry"/>
        </mxCell>

        <!-- Plot area background -->
        <mxCell id="plotbg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDCDCD;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="1400" height="500" as="geometry"/>
        </mxCell>

        <!-- Post-zero leakage shading -->
        <mxCell id="postshade" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEEF1;strokeColor=none;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="900" y="200" width="700" height="500" as="geometry"/>
        </mxCell>

        <!-- Normal threshold line (3.5 g/dL) -->
        <mxCell id="normalLine" style="endArrow=none;strokeColor=#5B8A5E;strokeWidth=2;strokeDasharray=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="370" as="sourcePoint"/>
            <mxPoint x="1600" y="370" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="normalLineLabel" value="Normal ≥ 3.5 g/dL" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#5B8A5E;fontSize=15;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1440" y="345" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- Severe threshold line (2.5 g/dL) -->
        <mxCell id="severeLine" style="endArrow=none;strokeColor=#D64309;strokeWidth=2;strokeDasharray=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="550" as="sourcePoint"/>
            <mxPoint x="1600" y="550" as="targetPoint"/>
