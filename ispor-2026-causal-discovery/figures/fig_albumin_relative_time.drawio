        <!-- Post-zero callout -->
        <mxCell id="postCallout" value="τ &gt; 0 · leakage zone, excluded from discovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEEF1;fontColor=#8A94A6;strokeColor=#8A94A6;strokeWidth=2;strokeDasharray=6 4;fontSize=16;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
