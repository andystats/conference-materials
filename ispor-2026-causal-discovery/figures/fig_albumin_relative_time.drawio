        </mxCell>
        <mxCell id="severeLineLabel" value="Severe &lt; 2.5 g/dL" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#D64309;fontSize=15;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1450" y="555" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- Zero (HAPrI) vertical line -->
        <mxCell id="zeroLine" style="endArrow=none;strokeColor=#0033A0;strokeWidth=5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="160" as="sourcePoint"/>
            <mxPoint x="900" y="710" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="zeroNode" value="HAPrI dx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0033A0;fontColor=#ffffff;strokeColor=#0033A0;fontSize=16;fontFamily=Arial;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="846" y="160" width="108" height="34" as="geometry"/>
        </mxCell>

        <!-- Trajectory as a polyline (as edge) -->
