        </mxCell>
        <mxCell id="fluid" value="Fluid management&#xa;&lt;i&gt;patterns flagged&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EA;fontColor=#D64309;strokeColor=#D64309;strokeWidth=3;fontSize=13;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="300" y="770" width="220" height="60" as="geometry"/>
