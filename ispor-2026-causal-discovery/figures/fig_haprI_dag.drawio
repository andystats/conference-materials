        <mxCell id="yeast" value="Yeast colonization&#xa;&lt;i&gt;rediscovered&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#0033A0;strokeColor=#0033A0;strokeWidth=3;fontSize=13;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
