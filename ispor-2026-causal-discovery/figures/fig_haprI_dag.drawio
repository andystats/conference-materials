        <!-- Hypoalbuminemia (orange hero node) -->
        <mxCell id="hypo" value="Hypoalbuminemia&#xa;candidate upstream driver&#xa;&lt;i&gt;pending confirmatory TMLE&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D64309;fontColor=#ffffff;strokeColor=#D64309;strokeWidth=5;fontSize=14;fontFamily=Arial;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="580" y="430" width="240" height="100" as="geometry"/>
