<mxfile host="app.diagrams.net" modified="2026-04-15" type="device">
  <diagram name="HAPrI DAG" id="hapri-dag">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

