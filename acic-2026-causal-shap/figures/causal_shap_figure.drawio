        </mxCell>

        <!-- ============ FOOTER ============ -->
        <mxCell id="footer" value="The closer a variable sits to Y, the more SHAP credit it absorbs — even when it isn't the cause." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#D4645C;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="700" height="30" as="geometry"/>
