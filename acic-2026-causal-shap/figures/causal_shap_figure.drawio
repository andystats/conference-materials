        <mxCell id="e_b2d2" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#E8A838;endSize=7;" edge="1" source="b2" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge Y→D (to collider) -->
        <mxCell id="e_y2d2" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#E8A838;endSize=7;" edge="1" source="y2" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- SHAP annotation panel 2 -->
        <mxCell id="shap2_label" value="SHAP thinks:" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="shap2_val1" value="&lt;b&gt;B → Y&lt;/b&gt;,&amp;nbsp; &lt;b style=&quot;color:#E8A838&quot;&gt;D → Y&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#D4645C;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="345" width="250" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="shap2_note" value="&lt;i&gt;collider flips the sign;&lt;br&gt;confounder credit bleeds into B&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#999999;fontFamily=Helvetica;" vertex="1" parent="1">
