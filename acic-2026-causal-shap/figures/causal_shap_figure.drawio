<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Causal SHAP" id="causal-shap-fig">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ============ PANEL 1: Simple Chain ============ -->

        <!-- Panel 1 Title -->
        <mxCell id="t1" value="&lt;b&gt;1.&lt;/b&gt;  A → B → Y" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Node A (blue) -->
        <mxCell id="a1" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#4A90D9;strokeColor=#3A7BC8;fontColor=#FFFFFF;fontSize=18;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Node B (coral) -->
        <mxCell id="b1" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D4645C;strokeColor=#B84E47;fontColor=#FFFFFF;fontSize=18;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Node Y (dark) -->
        <mxCell id="y1" value="Y" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#444444;strokeColor=#333333;fontColor=#FFFFFF;fontSize=18;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Edge A→B -->
        <mxCell id="e_a1b1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#555555;endSize=8;" edge="1" source="a1" target="b1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge B→Y -->
        <mxCell id="e_b1y1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#555555;endSize=8;" edge="1" source="b1" target="y1" parent="1">
