          <mxGeometry x="200" y="260" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Node D (amber, below) — collider -->
        <mxCell id="d2" value="D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E8A838;strokeColor=#CC8F2E;fontColor=#FFFFFF;fontSize=18;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="60" height="60" as="geometry"/>
