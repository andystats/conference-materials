        <mxCell id="sep" value="" style="line;strokeWidth=1;strokeColor=#CCCCCC;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="840" height="10" as="geometry"/>
        </mxCell>

        <!-- ============ PANEL 2: Chain + Confounder + Collider ============ -->

        <!-- Panel 2 Title -->
        <mxCell id="t2" value="&lt;b&gt;2.&lt;/b&gt;  A → B → Y,  with confounder C and collider D" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="500" height="30" as="geometry"/>
